# Runtime venv created by LAUNCH_Tool.py.
.hbttools/

# Build-only venv created by build_rust_kernels.py — has maturin in it
# but is never read at runtime.  Intentionally separate from .hbttools/
# so the runtime venv (and requirements.txt) stay free of build tools.
.hbttools_build/

# Python bytecode caches.
__pycache__/
*.pyc

# Rust build outputs (regenerated by build_rust_kernels.py).
# The compiled .pyd / .so files under tools/SSM/rust_kernels/bin/<arch>/
# ARE tracked — they're the whole point of the build script.
tools/SSM/rust_kernels/target/
s2p/

# Generated GDS stress-test masks (hundreds of MB — regenerate with
# gds/_gen_test_gds.py, see gds/README.md).  The generator and the
# limits sweep next to them ARE tracked.
gds/masks/
gds/masks_extra/
